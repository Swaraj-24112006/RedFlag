# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-development-key-for-kaizen-sfc-2026
DEBUG=True

# Database (PostgreSQL)
POSTGRES_DB=redflag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO S3 Object Storage
# Internal endpoint for server-side operations (container network or local)
MINIO_ENDPOINT_INTERNAL=http://localhost:9000
# Public endpoint used by browser for presigned GET/POST uploads
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=redflag-evidence
MINIO_SECURE=False

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
